AWS_BUCKET_NAME=your_bucket_name
# --- Capacity / load management (all optional; the defaults are measured, see below) ---
# The neural network is the only expensive thing the app does (~4s of CPU per submission on a
# 4-core box) so it gets its own budget, separate from how many requests the app can hold.
# Measured in a container capped to the target VPS (8 GB, 4 cores): 20 students submitting at
# the same instant all succeed in 28s, 40 in 56s, 60 in 82s (4.1 GB peak); at 80, 63 are served
# and the other 17 get an immediate 503 rather than anything crashing. Ordinary page loads stayed
# at ~10ms throughout, with 57 submissions queued behind them.
#
# How many analyses run at once. Above ~4 the cores are already full, so raising this adds
# latency without adding throughput.
# MAX_CONCURRENT_ANALYSES=3
# Threads per analysis. Leave at 1 on 4 cores. On a 6-core server set 2: one student submitting
# alone then waits ~2.2s instead of ~3.5s, and a class of 20 finishes in 26s instead of 30s.
# Rule of thumb: MAX_CONCURRENT_ANALYSES x TORCH_NUM_THREADS <= number of cores.
# TORCH_NUM_THREADS=1
# How many may wait before the app answers 503 + Retry-After instead. Must stay below
# GUNICORN_THREADS, since a waiting request holds a thread.
# MAX_QUEUED_ANALYSES=60
# Give up waiting after this many seconds and refuse, rather than holding the connection.
# ANALYSIS_QUEUE_TIMEOUT=600
# How many requests the app can hold at once. Only needs to cover the queue plus page loads.
# GUNICORN_THREADS=72
# One worker only: each loads its own ~2.4 GB copy of the models.
# GUNICORN_WORKERS=1
# Connection pool, sized against GUNICORN_THREADS (must stay under Postgres max_connections).
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=60
#
# Watch the live picture at GET /health/load (no auth; no student data in it).
